{
  "name": "@local/dsh-web-agent-presets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Presets management in the Web UI: create, duplicate, edit and delete named agent presets.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
